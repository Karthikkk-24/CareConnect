API_PORT=4000

# REQUIRED — Supabase Dashboard → Settings → Database → Connection string (URI)
# Paste your full URI below (must end with /postgres). Example shape:
# postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://REPLACE_WITH_YOUR_SUPABASE_CONNECTION_STRING

# Set to true when using Supabase cloud (required for remote connections)
DATABASE_SSL=true

# REQUIRED — Get from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=REPLACE_WITH_YOUR_SUPABASE_JWT_SECRET

CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
