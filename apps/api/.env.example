API_PORT=4000

# REQUIRED — Neon Dashboard → Connection string (prefer direct/session host for TypeORM)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://REPLACE_WITH_YOUR_NEON_CONNECTION_STRING

# Set to true for Neon (required for remote SSL)
DATABASE_SSL=true

# REQUIRED — Clerk secret key (Dashboard → API Keys). Never commit the real value.
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_CLERK_SECRET_KEY

# Clerk Frontend API / JWKS issuer (from Dashboard → API Keys → Frontend API)
# Example: https://your-app.clerk.accounts.dev
CLERK_ISSUER=https://REPLACE_WITH_YOUR_CLERK_FRONTEND_API

# Optional — comma-separated authorized parties (azp) allowed in Clerk JWTs
# Example: http://localhost:3000,https://your-app.example.com
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional — public API URL base for uploaded document links
API_PUBLIC_URL=http://localhost:4000
